    "resale":      {"file": "Property and buildings/property.png",  "red": true,  "fallback": "tower",     "palette": "property", "use": "resale condo, generic residential block"},
    "newlaunch":   {"file": "Property and buildings/residential.png","red": false,"fallback": "tower",     "palette": "property", "use": "new launch condo, high-rise living"},
