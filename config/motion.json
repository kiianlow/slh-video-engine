{
  "_comment": "Motion system. Rule: a new motion beat at least every 2 seconds. Never linear except continuous spins and ambient particles.",
  "transitions": {
    "overlap_s": 0.42,
    "exit_s": 0.45,
    "exit_rise_px": 95,
    "enter_from_px": 75,
    "sweep_lead_s": 0.12,
    "sweep_span_s": 0.54,
    "sweep_width_px": 420,
    "sweep_alpha": 58,
    "styles": [
      "push_up",
      "wipe_across",
      "zoom_through",
      "slide_side",
      "dissolve_glow"
    ],
    "_styles_note": "Rotated per scene boundary so consecutive videos do not cut the same way. Set topic-level 'transition' to force one."
  },
  "easing": {
    "default": "ease_out_quint",
    "entrance": "back_out",
    "spring": "spring_out",
    "continuous": "linear",
    "back_overshoot": 1.45,
    "spring_damping": 0.42,
    "_overshoot_note": "1.45 not 1.70158. Softened during the MOP render so motion settles instead of bouncing. Approved."
  },
  "entrance_stagger": {
    "kicker_ms": 0,
    "icon_ms": 140,
    "headline_ms": 300,
    "card_ms": 480,
    "accent_bar_wipe_ms": 620,
    "each_duration_ms": 520
  },
  "beats": {
    "_comment": "Seconds from scene start. Keeps a new beat landing at least every 2s across a 10s scene.",
    "pulse_ring": [
      0.0,
      1.5,
      3.5,
      6.0,
      8.5
    ],
    "headline_shine": [
      2.2,
      4.4,
      6.6,
      8.8
    ],
    "icon_spring_bounce": [
      3.0,
      5.5,
      8.0
    ],
    "icon_wiggle": [
      4.5,
      7.5
    ],
    "counter_pop": [
      3.0,
      6.0,
      9.0
    ]
  },
  "continuous": {
    "icon_float_amplitude_px": 8,
    "icon_float_period_s": 2.0,
    "icon_sway_deg": 2.0,
    "particle_count": 0,
    "particle_speed_px_s": 0,
    "particle_opacity": 0.0,
    "grain_opacity": 0.03,
    "blob_drift_px": 40,
    "blob_period_s": 9.0,
    "_particles_note": "ZERO. Kiian removed particles on four separate approved videos. Never re-enable without him asking.",
    "ghost_parallax_px": 6,
    "ghost_scale_max": 1.02,
    "ghost_period_s": 6.0
  },
  "icon_moves": {
    "_comment": "Per-scene icon behaviour. Pick one in scenes.json via icon_move. Raster morph swaps use spin+scale out/in with a 0.4s cross-dissolve.",
    "options": [
      "spin360",
      "card_flip",
      "coin_flip",
      "float_bob",
      "drop_squash",
      "pulse_scale",
      "swing_in",
      "zoom_punch",
      "tilt_shake",
      "pendulum",
      "heartbeat",
      "barrel_roll",
      "rise_glow"
    ],
    "spin360_duration_ms": 900,
    "flip_duration_ms": 700,
    "drop_squash_ms": 620,
    "orbit_period_s": 6.0,
    "morph_crossfade_ms": 400,
    "supersample": 3,
    "swing_ms": 820,
    "punch_ms": 420,
    "shake_ms": 560,
    "pendulum_deg": 11,
    "pendulum_period_s": 2.6,
    "heartbeat_period_s": 1.9,
    "barrel_ms": 1500
  },
  "shine": {
    "sweep_duration_ms": 700,
    "band_width_px": 220,
    "band_opacity": 0.3,
    "angle_deg": 18
  },
  "pulse_ring": {
    "duration_ms": 1400,
    "start_radius_px": 150,
    "end_radius_px": 330,
    "start_opacity": 0.3,
    "stroke_px": 5
  },
  "headline": {
    "letter_stagger_s": 0.03,
    "letter_duration_s": 0.45,
    "rise_px": 34,
    "easing": "ease_out_cubic",
    "shine_duration_s": 0.8
  },
  "texture": {
    "_comment": "Surface texture layers. All precomputed once and cached, so they cost nothing per frame. 'rotate' picks a different paper per video from the topic slug, which is the cheapest way to stop every video looking identical.",
    "rotate": true,
    "styles": [
      "paper",
      "linen",
      "halftone",
      "speckle",
      "plain"
    ],
    "opacity": {
      "paper": 0.085,
      "linen": 0.065,
      "halftone": 0.055,
      "speckle": 0.075,
      "plain": 0.0
    },
    "vignette": {
      "enabled": true,
      "strength": 0.16,
      "feather": 0.62
    },
    "top_light": {
      "enabled": true,
      "strength": 0.07
    }
  },
  "camera": {
    "enabled": true,
    "_note": "Slow move on the scene art only. Handles, texture and vignette stay locked so the frame reads as a camera on a surface, not a wobbling picture. Styles rotate per scene so a 6-scene video never repeats a move.",
    "styles": [
      "push_in",
      "pull_out",
      "drift_left",
      "drift_right",
      "drift_up",
      "settle"
    ],
    "max_zoom": 0.045,
    "max_drift_px": 26,
    "settle_overshoot": 0.018
  }
}